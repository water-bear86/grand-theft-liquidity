# Frontend (baked in at build time for the static site)
# Leave unset in local `pnpm dev` to use the Vite /api proxy.
# VITE_LEADERBOARD_API=https://gtl-leaderboard.onrender.com

# Leaderboard + shooting gallery API service
# PORT=8787
# Comma-separated browser origins allowed to call the API.
# CORS_ORIGIN=http://127.0.0.1:5173,https://grand-theft-liquidity.onrender.com
# Render / Neon / any Postgres URL. If unset, scores, pots and payout logs live in memory and reset on restart.
# DATABASE_URL=postgres://USER:PASSWORD@HOST/DB

# Shooting gallery. Use the same cluster for the RPC and the house wallet.
# HOUSE_WALLET=
# House keypair: JSON byte array, hex, or base58. Never commit this. Never log it.
# HOUSE_WALLET_SECRET=
# SOLANA_RPC_URL=
# Defaults to true (payouts are recorded but not sent). Set to false only when you are ready to pay winners.
# GALLERY_DRY_RUN=true
