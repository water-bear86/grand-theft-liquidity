# Frontend (baked in at build time for the static site)
# Leave unset in local `pnpm dev` to use the Vite /api proxy.
# VITE_LEADERBOARD_API=https://gtl-leaderboard.onrender.com

# Leaderboard API service
# PORT=8787
# Comma-separated browser origins allowed to call the API.
# CORS_ORIGIN=http://127.0.0.1:5173,https://grand-theft-liquidity.onrender.com
# Render / Neon / any Postgres URL. If unset, scores live in memory and reset on restart.
# DATABASE_URL=postgres://USER:PASSWORD@HOST/DB
